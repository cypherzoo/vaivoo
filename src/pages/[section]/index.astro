---
import Base from '../../layouts/Base.astro';
import ReviewTag from '../../components/ReviewTag.astro';
import { allEntities, publicClaims, reviewSummary, SECTIONS, LABELS } from '../../lib/content.mjs';
export function getStaticPaths() {
  return Object.values(SECTIONS).map(section => ({ params: { section } }));
}
const { section } = Astro.params;
const items = allEntities().filter(e => e.section === section).map(e => ({ e, s: reviewSummary(publicClaims(e)) }));
---
<Base title={LABELS[section]} noindex={items.length === 0}>
  <p class="eyebrow"><a href="/reference/">Reference</a><span>/</span><span>{items.length} {items.length === 1 ? 'entry' : 'entries'}</span></p>
  <h1>{LABELS[section]}</h1>
  {items.length === 0 ? <p class="meta">No entries yet.</p> :
  <ul class="rows full">{items.map(({ e, s }) => <li><a class="row" href={e.url}>
    <span class="row-title">{e.name}</span>
    <span class="row-sum">{e.summary}</span>
    <span class="row-tags">{['external', 'internal', 'draft', 'disputed'].filter(l => s.counts[l] > 0).map(l => <ReviewTag level={l} count={s.counts[l]} short />)}</span>
  </a></li>)}</ul>}
</Base>
