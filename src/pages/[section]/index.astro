---
import Base from '../../layouts/Base.astro';
import { allEntities, SECTIONS, LABELS } from '../../lib/content.mjs';
export function getStaticPaths() {
  return Object.values(SECTIONS).map(section => ({ params: { section } }));
}
const { section } = Astro.params;
const items = allEntities().filter(e => e.section === section);
---
<Base title={LABELS[section]}>
  <h1>{LABELS[section]}</h1>
  {items.length === 0 ? <p class="meta">No reviewed entries yet.</p> :
  <ul>{items.map(e => <li><a href={e.url}>{e.name}</a> — {e.summary} {e.status !== 'published' && <span class="pill">{e.status}</span>}</li>)}</ul>}
</Base>
