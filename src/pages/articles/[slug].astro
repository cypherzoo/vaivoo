---
import Base from '../../layouts/Base.astro';
import { loadArticles, dayLabel } from '../../lib/articles.mjs';
import { byId } from '../../lib/content.mjs';
import { AUTHORS, LINKEDIN_PAGE } from '../../lib/site.mjs';
export function getStaticPaths() {
  return loadArticles(import.meta.glob('../../../content/articles/*.md', { eager: true })).map(a => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props;
const Content = a.Content;
const related = (a.related || []).map(byId).filter(Boolean);
const au = AUTHORS[a.author] ?? { name: a.author };
---
<Base title={a.title} description={a.summary}>
  <p class="eyebrow"><a href="/articles/">Articles</a><span>/</span><span class="eb-accent">{a.category}</span><span>·</span><span>{dayLabel(a.date)}</span><span>·</span><span>{a.minutes} min read</span></p>
  <h1>{a.title}</h1>
  <p class="lede">{a.summary}</p>
  <p class="byline"><img src="/vaivoo-mark.svg" alt="" width="22" height="22" /><span>By {au.linkedin ? <a href={au.linkedin} rel="noopener author"><strong>{au.name}</strong></a> : <strong>{au.name}</strong>}</span>{au.role && <span class="meta">{au.role}</span>}</p>
  <article class="guide"><Content /></article>
  {a.sources?.length > 0 && <section class="art-src"><h2>Sources</h2><ol>{a.sources.map(s => <li><a href={s.url} rel="noopener">{s.title}</a><span class="meta"> — {s.publisher}</span></li>)}</ol></section>}
  {related.length > 0 && <section><h2>In the reference</h2><ul>{related.map(e => <li><a href={e.url}>{e.name}</a></li>)}</ul></section>}
  {au.bio && <aside class="author-card"><img src="/vaivoo-mark.svg" alt="" width="40" height="40" /><div><p class="eyebrow" style="margin:0 0 4px">About the author</p><p><strong>{au.name}</strong> · {au.role}</p><p class="note">{au.bio}</p><p class="meta"><a href={au.linkedin} rel="noopener">{au.name} on LinkedIn</a> · <a href={LINKEDIN_PAGE} rel="noopener">The Vaivoo Project on LinkedIn</a></p></div></aside>}
  <p class="meta art-foot">Articles are analysis, not reference claims: facts are as reported by the sources above on the date shown; calculations and inferences are marked as such. <a href="/corrections/">Report a correction</a></p>
</Base>
<style>
  .byline { display:flex; align-items:center; gap:10px; margin:0 0 32px; padding:12px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); font-size:15px; }
  .byline img { border-radius:17%; }
  .byline .meta { margin-left:auto; }
  .author-card { display:flex; gap:16px; align-items:flex-start; margin-top:48px; padding:20px 0; border-top:3px solid var(--rule); border-bottom:1px solid var(--line); }
  .author-card img { border-radius:17%; flex:none; }
  .author-card p { margin:0 0 6px; }
  @media (max-width: 560px) { .byline { flex-wrap:wrap; } .byline .meta { margin-left:0; flex-basis:100%; } }
  .art-src ol { padding-left:1.4em; } .art-src li { margin:6px 0; }
  .art-foot { margin-top:40px; }
</style>
