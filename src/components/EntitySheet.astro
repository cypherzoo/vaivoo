---
import { publicClaims, reviewSummary, monthLabel, VALUE_LABEL, LABELS, REVIEW } from '../lib/content.mjs';
import { docId, rev, num, sources } from '../lib/sheet.mjs';
const { e, generated } = Astro.props;
const claims = publicClaims(e);
const s = reviewSummary(claims);
const pct = n => (s.total ? (100 * n) / s.total : 0);
const srcs = sources(claims);
const refOf = i => 'S' + String(i + 1).padStart(2, '0');
const srcIndex = url => srcs.findIndex(x => x.url === url);
const live = `vaivoo.com${e.url}`;
---
<article class="sheet">
  <header class="hd">
    <div class="brand"><img src="/vaivoo-mark.svg" alt="" /><span>VAIVOO</span></div>
    <div class="ttl"><h1>{e.name}</h1><span class="id">{docId(e)} · REV {rev(e.last_verified_at)}</span></div>
    <div class="kind"><span class="dots" aria-hidden="true"><i class="o"></i><i></i><i class="o"></i><i class="o"></i><i class="o"></i><i></i><i class="o"></i><i class="o"></i><i></i></span>{LABELS[e.section]}</div>
  </header>
  <div class="acc"></div>
  <div class="meta">
    <div><span class="k">Claims</span><span class="v">{s.total}</span></div>
    <div><span class="k">Last verified</span><span class="v">{monthLabel(e.last_verified_at) ?? '—'}</span></div>
    <div><span class="k">Next review</span><span class="v">{monthLabel(e.next_review_at) ?? '—'}</span></div>
    <div><span class="k">Editor</span><span class="v">{e.owner}</span></div>
    <div><span class="k">Review</span><span class="rbar"><span class="e" style={`width:${pct(s.counts.external)}%`}></span><span class="i" style={`width:${pct(s.counts.internal)}%`}></span></span><span class="k" style="color:var(--ink)">{s.counts.external} ext · {s.counts.internal} int · {s.counts.draft} draft</span></div>
  </div>
  <p class="sum">{e.summary}</p>

  <div class="sec"><span>01 · Claims</span><span><b>{s.total}</b> scoped statements</span></div>
  <table>
    <thead><tr><th>#</th><th>Property</th><th>Value</th><th>Claim and scope</th><th>Evidence</th></tr></thead>
    <tbody>{claims.map((c, i) => (
      <tr>
        <td class="n">{num(i)}</td>
        <td class="p">{c.predicate.replaceAll('_', ' ')}</td>
        <td class="val"><span class="vv">{VALUE_LABEL[c.shown]}</span><span class={`st ${c.review}`}>{REVIEW[c.review]?.short}</span>
          {c.reviewed_by?.length > 0 && c.review !== 'draft' && <span class="who">{c.reviewed_by.join(', ')}{c.reviewed_at && ` · ${rev(c.reviewed_at)}`}</span>}</td>
        <td>{c.statement}{c.assumptions.length > 0 && <ul>{c.assumptions.map(a => <li>{a}</li>)}</ul>}<span class="scope">Scope: {c.scope}{c.claim_type !== 'fact' && ` · ${c.claim_type.replace('_', ' ')}`}</span></td>
        <td class="ev" data-label="Evidence">{c.evidence.map(ev => <div><span class="r">{refOf(srcIndex(ev.url))}</span> {ev.locator}{ev.stance !== 'supports' && ` (${ev.stance})`}</div>)}</td>
      </tr>))}
    </tbody>
  </table>

  <div class="sec"><span>02 · Sources</span><span><b>{srcs.length}</b> documents</span></div>
  <ol class="src">{srcs.map((x, i) => <li><span class="r">{refOf(i)}</span><b>{x.title}</b> — {x.publisher}{x.version && `, ${x.version}`}. Retrieved {monthLabel(x.retrieved_at)}.<span class="u">{x.url}</span></li>)}</ol>

  <footer class="ft">
    <span class="lic"><b>The Vaivoo Project</b> · Snapshot of the live entry at <b>{live}</b>, generated {generated}. Claims change when sources change; check the live page before relying on this sheet.</span>
    <span>{docId(e)}</span>
  </footer>
</article>
