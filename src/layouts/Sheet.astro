---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import '@fontsource-variable/schibsted-grotesk/wght.css';
const { title, id, back, backLabel = 'Back to the page', landscape = false } = Astro.props;
const pdf = `/pdf/${id}.pdf`;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{`${id} · ${title} · The Vaivoo Project datasheet`}</title>
  <meta name="robots" content="noindex" />
  <link rel="icon" href="/vaivoo-favicon.svg" type="image/svg+xml" />
  {landscape && <style is:inline>@page { size: A4 landscape; } @media screen and (min-width: 1180px) { .sheet { width: 297mm !important; } }</style>}
  <style is:global>
    :root { --ink:#0a0a0a; --mute:#555; --line:#cfcfcc; --acc:#5b2bff; --ext:#15703f; --int:#c2560c;
      --cond:'Archivo Variable', 'Archivo', 'Arial Narrow', sans-serif; --mono:'IBM Plex Mono', ui-monospace, Menlo, Consolas, monospace; --sans:'Schibsted Grotesk Variable', system-ui, sans-serif; }
    @page { size: A4; margin: 11mm 11mm 13mm; }
    * { box-sizing:border-box; }
    html { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    body { margin:0; background:#e8e8e5; color:var(--ink); font:400 9.5pt/1.45 var(--sans); }
    a { color:inherit; }
    ::selection { background:var(--acc); color:#fff; }

    /* toolbar (screen only) */
    .bar { position:sticky; top:0; z-index:5; background:var(--ink); color:#fff; display:flex; align-items:center; gap:16px; padding:10px clamp(12px, 3vw, 28px); font:500 12px/1.3 var(--mono); }
    .bar a.back { color:#fff; text-decoration:none; opacity:.8; } .bar a.back:hover { opacity:1; }
    .bar .bid { opacity:.6; letter-spacing:.03em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .bar .sp { flex:1; }
    .print { appearance:none; cursor:pointer; background:transparent; color:#fff; border:1px solid #555; padding:9px 12px; font:500 12px/1 var(--mono); letter-spacing:.06em; text-transform:uppercase; }
    .print:hover { border-color:#fff; }
    .save { appearance:none; border:0; cursor:pointer; text-decoration:none; white-space:nowrap; display:inline-flex; align-items:center; gap:10px; padding:10px 16px; font:700 12px/1 var(--mono); letter-spacing:.06em; text-transform:uppercase; color:#fff; background:var(--acc) linear-gradient(90deg, #fff 0 0) no-repeat 0 100% / 0 2px; transition:background-size .25s ease; }
    .save:hover { background-size:100% 2px; }
    .save:focus-visible { outline:2px solid #fff; outline-offset:2px; }
    .hint { padding:10px clamp(12px, 3vw, 28px); font:400 12px/1.5 var(--mono); color:var(--mute); text-align:center; }

    .stage { padding:8px 12px 48px; display:flex; flex-direction:column; align-items:safe center; gap:24px; overflow-x:auto; }
    .sheet { width:210mm; min-height:297mm; background:#fff; padding:11mm; box-shadow:0 1px 2px rgba(0,0,0,.08), 0 12px 40px rgba(0,0,0,.12); }

    @media print {
      body { background:#fff; }
      .bar, .hint { display:none !important; }
      .stage { padding:0; display:block; overflow:visible; }
      .sheet { width:auto !important; min-height:0; padding:0; box-shadow:none; }
      .sheet + .sheet { break-before:page; }
      tr, .src li { break-inside:avoid; }
      thead { display:table-header-group; }
    }

    /* sheet head */
    .hd { display:grid; grid-template-columns:auto minmax(0, 1fr) auto; border:1.6pt solid var(--ink); }
    .hd .brand { background:var(--ink); color:#fff; display:flex; align-items:center; gap:3mm; padding:3mm 4mm; }
    .hd .brand img { width:7mm; height:7mm; border-radius:17%; box-shadow:0 0 0 .4pt #555; }
    .hd .brand span { font:800 13pt/1 var(--cond); font-stretch:125%; letter-spacing:.02em; }
    .hd .ttl { padding:2.5mm 4mm; display:flex; flex-direction:column; justify-content:center; gap:1mm; border-right:.8pt solid var(--ink); min-width:0; }
    .hd .ttl h1 { margin:0; font:900 19pt/1 var(--cond); font-stretch:78%; text-transform:uppercase; letter-spacing:.005em; }
    .hd .ttl .id { font:500 7.5pt/1.2 var(--mono); }
    .hd .kind { padding:2.5mm 4mm; display:flex; flex-direction:column; justify-content:center; align-items:flex-end; gap:1.5mm; font:500 7.5pt/1.2 var(--mono); text-transform:uppercase; }
    .dots { display:grid; grid-template-columns:repeat(3, 1.6mm); gap:.7mm; }
    .dots i { width:1.6mm; height:1.6mm; border-radius:50%; background:var(--ink); }
    .dots i.o { background:transparent; box-shadow:inset 0 0 0 .5pt var(--ink); }
    .acc { height:1.4mm; background:var(--acc); border:1.6pt solid var(--ink); border-top:0; }

    .meta { display:grid; grid-template-columns:repeat(5, minmax(0, 1fr)); border:1.6pt solid var(--ink); border-top:0; }
    .meta > div { padding:2mm 3mm; border-right:.6pt solid var(--ink); display:flex; flex-direction:column; gap:1mm; }
    .meta > div:last-child { border-right:0; }
    .k { font:500 6.5pt/1.2 var(--mono); text-transform:uppercase; letter-spacing:.05em; color:var(--mute); }
    .v { font:700 10pt/1.15 var(--cond); font-stretch:90%; }
    .rbar { display:flex; height:2.4mm; border:.6pt solid var(--ink); margin-top:.6mm; }
    .rbar .e { background:var(--ext); } .rbar .i { background:var(--int); }

    .sum { margin:4mm 0 0; padding:0 0 3.5mm; border-bottom:.6pt solid var(--ink); font:500 11pt/1.45 var(--sans); }
    .sec { display:flex; justify-content:space-between; align-items:baseline; margin:5mm 0 1.5mm; padding:1.2mm 2.5mm; background:var(--ink); color:#fff; font:500 7.5pt/1.2 var(--mono); text-transform:uppercase; letter-spacing:.05em; }
    .sec b { color:#b9a6ff; font-weight:700; }

    table { width:100%; border-collapse:collapse; font-size:8.3pt; line-height:1.4; }
    th, td { text-align:left; vertical-align:top; padding:1.8mm 2mm 1.8mm 0; border-bottom:.5pt solid var(--line); }
    thead th { font:500 6.5pt/1.2 var(--mono); text-transform:uppercase; letter-spacing:.05em; color:var(--mute); border-bottom:1pt solid var(--ink); }
    td.n { font:700 7.5pt/1.4 var(--mono); color:var(--acc); white-space:nowrap; width:9mm; }
    td.p { font:700 8.5pt/1.25 var(--cond); font-stretch:90%; text-transform:uppercase; width:24mm; }
    td.val { width:25mm; }
    .vv { display:block; font:700 7.5pt/1.3 var(--mono); text-transform:uppercase; }
    .st { display:inline-flex; align-items:center; gap:1mm; margin-top:1mm; padding:.2mm 1.2mm; border:.7pt solid currentColor; font:500 6pt/1.4 var(--mono); text-transform:uppercase; letter-spacing:.04em; }
    .st::before { content:''; width:1.3mm; height:1.3mm; border-radius:50%; background:currentColor; }
    .st.external { color:var(--ext); } .st.internal { color:var(--int); }
    .st.draft, .st.disputed { color:var(--ink); border-style:dashed; } .st.draft::before, .st.disputed::before { background:transparent; box-shadow:inset 0 0 0 .6pt currentColor; }
    .who { display:block; font:400 6.5pt/1.3 var(--mono); color:var(--mute); margin-top:.8mm; }
    .scope { display:block; color:var(--mute); font-size:7.5pt; margin-top:.8mm; }
    td ul { margin:.8mm 0 0; padding-left:3.5mm; font-size:7.8pt; }
    td.ev { width:44mm; font:400 7pt/1.35 var(--mono); }
    td.ev .r { color:var(--acc); font-weight:700; }

    .src { list-style:none; padding:0; margin:0; columns:2; column-gap:6mm; font-size:7.5pt; }
    .src li { padding:1.2mm 0; border-bottom:.5pt solid var(--line); break-inside:avoid; }
    .src .r { font:700 7pt var(--mono); color:var(--acc); margin-right:1.5mm; }
    .src .u { display:block; font:400 6.5pt/1.3 var(--mono); color:var(--mute); word-break:break-all; }

    .ft { margin-top:5mm; padding-top:2mm; border-top:1.6pt solid var(--ink); display:flex; justify-content:space-between; gap:6mm; font:400 6.5pt/1.4 var(--mono); color:var(--mute); }
    .ft b { color:var(--ink); font-weight:700; }
    .ft .lic { max-width:110mm; }

    /* phones and tablets: a fluid sheet that reads like a page, not a scaled-down A4 */
    @media screen and (max-width: 860px) {
      body { font-size:15px; }
      .bar { gap:10px; padding:8px 12px; }
      .bar .bid { display:none; }
      .print { display:none; }
      .hint { font-size:11px; padding:8px 12px; }
      .stage { padding:0 0 32px; display:block; }
      .sheet { width:100% !important; min-height:0; padding:16px; box-shadow:none; }
      .hd { grid-template-columns:1fr; }
      .hd .brand { padding:10px 12px; }
      .hd .brand img { width:24px; height:24px; }
      .hd .brand span { font-size:17px; }
      .hd .ttl { border-right:0; border-top:.8pt solid var(--ink); padding:10px 12px; }
      .hd .ttl h1 { font-size:clamp(24px, 7vw, 34px); }
      .hd .ttl .id { font-size:11px; }
      .hd .kind { flex-direction:row; justify-content:space-between; align-items:center; border-top:.6pt solid var(--ink); padding:8px 12px; font-size:11px; }
      .dots { grid-template-columns:repeat(3, 6px); gap:3px; } .dots i { width:6px; height:6px; }
      .acc { height:5px; }
      .meta { grid-template-columns:1fr 1fr; }
      .meta > div { padding:8px 10px; border-bottom:.6pt solid var(--ink); }
      .meta > div:nth-child(2n) { border-right:0; }
      .meta > div:last-child { grid-column:1 / -1; border-bottom:0; }
      .k { font-size:10px; } .v { font-size:17px; }
      .rbar { height:8px; }
      .sum { font-size:17px; margin-top:14px; padding-bottom:14px; }
      .sec { margin:20px 0 4px; padding:6px 10px; font-size:11px; }
      table, tbody, tr, td { display:block; width:auto !important; }
      thead { display:none; }
      table { font-size:15px; }
      tr { display:grid; grid-template-columns:auto 1fr; column-gap:10px; padding:14px 0; border-bottom:1px solid var(--line); }
      td { border:0; padding:0; }
      td.n { grid-column:1; font-size:12px; padding-top:2px; }
      td.p { grid-column:2; font-size:16px; }
      td:not(.n):not(.p) { grid-column:1 / -1; margin-top:8px; }
      td.val { display:flex; flex-wrap:wrap; align-items:center; gap:6px 10px; }
      .vv { font-size:12px; } .st { font-size:10px; margin-top:0; padding:2px 6px; } .st::before { width:6px; height:6px; }
      .who { font-size:11px; margin-top:0; }
      .scope { font-size:13px; margin-top:4px; }
      td ul { font-size:14px; padding-left:18px; }
      td.ev { font-size:12px; line-height:1.5; padding-top:8px; border-top:1px dashed var(--line); }
      td[data-label]::before { content:attr(data-label); display:block; font:500 10px/1.4 var(--mono); text-transform:uppercase; letter-spacing:.05em; color:var(--mute); margin-bottom:4px; }
      .src { columns:1; font-size:14px; }
      .src li { padding:8px 0; }
      .src .u { font-size:11px; }
      .ft { flex-direction:column; gap:6px; font-size:11px; }
      .sheet + .sheet { margin-top:16px; border-top:6px solid var(--ink); }
    }
    @media screen and (min-width: 861px) and (max-width: 1180px) { .stage { align-items:stretch; } .sheet.wide { width:100% !important; } }
  </style>
</head>
<body>
  <div class="bar">
    <a class="back" href={back}>← {backLabel}</a>
    <span class="bid">{id}</span>
    <span class="sp"></span>
    <button class="print" type="button" id="save">Print</button>
    <a class="save" href={pdf} download={`vaivoo-${id}.pdf`} type="application/pdf">Download PDF ↓</a>
  </div>
  <p class="hint">A4 datasheet · the PDF is the same sheet, ready to file or forward.</p>
  <div class="stage"><slot /></div>
  <script is:inline>
    document.getElementById('save').addEventListener('click', () => window.print());
    if (new URLSearchParams(location.search).has('print')) {
      (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => setTimeout(() => window.print(), 250));
    }
  </script>
</body>
</html>
