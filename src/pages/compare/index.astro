---
import Base from '../../layouts/Base.astro';
import { allComparisons } from '../../lib/content.mjs';
const items = allComparisons();
---
<Base title="Compare" description="Side-by-side comparisons of authentication setups, built only from sourced claims.">
  <p class="eyebrow">Compare · {items.length} tables</p>
  <h1>Compare</h1>
  <p class="lede">Concrete setups side by side. Every cell comes from a sourced, scoped claim on an entry page. There is no overall score.</p>
  {items.length === 0 ? <p class="meta">No comparisons yet.</p> :
  <ul class="rows full">{items.map((c, i) => <li><a class="row" href={`/compare/${c.slug}/`}>
    <span class="row-title">{c.title} {c.status !== 'published' && <span class="pill">{c.status}</span>}</span>
    <span class="row-sum">{c.summary}</span>
    <span class="row-tags meta">{c.columns.length} × {c.rows.length}</span>
  </a></li>)}</ul>}
</Base>
