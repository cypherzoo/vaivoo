---
import { isPreview } from '../lib/content.mjs';
import '@fontsource-variable/schibsted-grotesk/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
const { title, description = 'Source-backed reference on digital authentication and the cryptography behind it.', noindex = false, wide = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  ['/guides/', 'Guides'], ['/compare/', 'Compare'], ['/reference/', 'Reference'], ['/methodology/', 'Method'], ['/search/', 'Search']
];
const sectionPaths = ['/methods/', '/profiles/', '/attacks/', '/credentials/', '/protocols/', '/standards/', '/crypto/', '/identity-systems/', '/regulations/'];
const active = href => path.startsWith(href) || (href === '/reference/' && sectionPaths.some(p => path.startsWith(p)));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} · Vaivoo` : 'Vaivoo — authentication, explained with evidence'}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="icon" href="/vaivoo-favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/vaivoo-mark.svg" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b0b0b" media="(prefers-color-scheme: dark)" />
  {noindex && <meta name="robots" content="noindex" />}
  <style is:global>

    :root {
      --bg:#ffffff; --fg:#0a0a0a; --muted:#5a5a5a; --line:#e4e4e4; --rule:#0a0a0a; --soft:#f5f5f4; --sel:#0a0a0a; --selfg:#ffffff;
      --ext:#15703f; --int:#c2560c; --dft:#0a0a0a;
      --sans:'Schibsted Grotesk Variable', 'Schibsted Grotesk', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
      --mono:'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
      --w:1160px; --gut:clamp(16px, 4vw, 40px);
    }
    @media (prefers-color-scheme: dark) { :root {
      --bg:#0b0b0b; --fg:#f2f2f0; --muted:#a3a3a0; --line:#2a2a2a; --rule:#f2f2f0; --soft:#161616; --sel:#f2f2f0; --selfg:#0b0b0b;
      --ext:#5cc98b; --int:#f0914f; --dft:#f2f2f0; } }

    *, *::before, *::after { box-sizing: border-box; }
    html { -webkit-text-size-adjust: 100%; }
    body { margin:0; background:var(--bg); color:var(--fg); font:400 17px/1.6 var(--sans); font-feature-settings:'ss01'; -webkit-font-smoothing:antialiased; }
    ::selection { background:var(--sel); color:var(--selfg); }
    a { color:inherit; text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:3px; }
    a:hover { text-decoration-thickness:2px; }
    :focus-visible { outline:2px solid var(--fg); outline-offset:3px; }
    img, svg { display:block; max-width:100%; }

    .wrap { max-width:var(--w); margin:0 auto; padding:0 var(--gut); }
    .skip { position:absolute; left:-9999px; } .skip:focus { left:var(--gut); top:12px; background:var(--bg); padding:6px 10px; z-index:10; }

    /* header */
    .site-head { border-top:6px solid var(--rule); border-bottom:1px solid var(--line); }
    .site-head .wrap { display:flex; align-items:center; justify-content:space-between; gap:24px; min-height:68px; }
    .brand { display:flex; align-items:center; gap:10px; text-decoration:none; }
    .brand img { width:28px; height:28px; border-radius:17%; }
    @media (prefers-color-scheme: dark) { .brand img { box-shadow:0 0 0 1px #3a3a3a; } }
    .brand span { font:700 21px/1 var(--mono); letter-spacing:-0.04em; }
    .site-nav { display:flex; gap:clamp(14px, 2.4vw, 28px); font-size:15px; font-weight:500; }
    .site-nav a { text-decoration:none; padding:6px 0; border-bottom:2px solid transparent; }
    .site-nav a:hover, .site-nav a[aria-current] { border-bottom-color:var(--fg); }
    @media (max-width: 720px) {
      .site-head .wrap { flex-wrap:wrap; gap:0; padding-top:14px; }
      .site-nav { width:100%; overflow-x:auto; padding:6px 0 10px; scrollbar-width:none; gap:20px; }
      .site-nav::-webkit-scrollbar { display:none; }
    }

    main { padding-top:clamp(32px, 6vw, 64px); padding-bottom:clamp(56px, 8vw, 96px); }
    main > .wrap > * { max-width:760px; }
    main.wide > .wrap > *, main > .wrap > .full { max-width:none; }

    /* type */
    h1, h2, h3 { line-height:1.08; letter-spacing:-0.025em; margin:0; }
    h1 { font-size:clamp(36px, 6vw, 64px); font-weight:800; margin:0 0 20px; }
    h2 { font-size:clamp(24px, 3vw, 32px); font-weight:750; margin:56px 0 16px; }
    h3 { font-size:20px; font-weight:700; margin:32px 0 10px; letter-spacing:-0.015em; }
    p { margin:0 0 16px; }
    ul, ol { padding-left:1.2em; margin:0 0 16px; } li { margin:4px 0; }
    .lede { font-size:clamp(19px, 2vw, 22px); line-height:1.5; }
    .meta, .eyebrow { font:400 13px/1.55 var(--mono); color:var(--muted); letter-spacing:0; }
    .note { font:400 14.5px/1.5 var(--sans); color:var(--muted); letter-spacing:0; text-transform:none; }
    thead th .note { margin-top:4px; font-size:13.5px; }
    td .note, th .note { margin-top:6px; }
    .eyebrow { display:flex; flex-wrap:wrap; gap:6px 14px; margin:0 0 18px; text-transform:uppercase; font-size:12px; letter-spacing:0.04em; }
    .eyebrow a { text-decoration:none; color:var(--fg); }
    .eyebrow a:hover { text-decoration:underline; }
    .sec-head { display:flex; justify-content:space-between; align-items:baseline; gap:16px; border-top:3px solid var(--rule); padding-top:14px; margin:72px 0 24px; }
    .sec-head h2 { margin:0; font-size:15px; font:500 13px/1 var(--mono); letter-spacing:0.04em; text-transform:uppercase; }
    .sec-head a { font:400 13px/1 var(--mono); text-decoration:none; }
    .sec-head a:hover { text-decoration:underline; }

    /* review stamps — the only colour on the site */
    .rv { display:inline-flex; align-items:center; gap:6px; padding:2px 8px; border:1.5px solid currentColor; font:500 11.5px/1.5 var(--mono); letter-spacing:0.03em; text-transform:uppercase; white-space:nowrap; margin:2px 6px 2px 0; vertical-align:middle; }
    .rv::before { content:''; width:7px; height:7px; border-radius:50%; background:currentColor; flex:none; }
    .rv b { font-weight:700; }
    .rv-external { color:var(--ext); } .rv-internal { color:var(--int); }
    .rv-draft, .rv-disputed { color:var(--dft); border-style:dashed; }
    .rv-draft::before, .rv-disputed::before { background:transparent; border:1.5px solid currentColor; }
    .rv-summary { display:flex; flex-wrap:wrap; align-items:center; gap:4px 8px; margin:0 0 28px; padding:12px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
    .rv-summary .meta { margin-right:4px; }
    .rv-summary p { flex-basis:100%; margin:6px 0 0; }
    ul.rv-legend { list-style:none; padding:0; display:grid; gap:14px; }
    ul.rv-legend li { display:grid; grid-template-columns:200px 1fr; gap:12px; align-items:baseline; margin:0; }
    @media (max-width: 560px) { ul.rv-legend li { grid-template-columns:1fr; gap:4px; } }

    /* values */
    .val { font:700 13px/1.4 var(--mono); text-transform:uppercase; letter-spacing:0.03em; }
    .val-conditional, .val-unknown { font-style:normal; }
    .val-unknown { color:var(--muted); }

    /* tables */
    .table-wrap { overflow-x:auto; margin:0 0 24px; border-top:2px solid var(--rule); }
    table { width:100%; border-collapse:collapse; font-size:15px; line-height:1.5; }
    th, td { text-align:left; vertical-align:top; padding:14px 14px 14px 0; border-bottom:1px solid var(--line); }
    th:last-child, td:last-child { padding-right:0; }
    thead th { font:500 12px/1.4 var(--mono); text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); padding-top:12px; padding-bottom:12px; }
    td .meta { margin-top:6px; }
    table.claims td:first-child { font-weight:700; width:18%; }
    table.claims td:nth-child(2) { width:15%; }
    table.claims td:last-child { width:27%; }
    table.claims ul { margin:8px 0 0; font-size:14.5px; }
    .ev a { font-weight:500; }
    .ev + .ev { margin-top:10px; }
    @media (max-width: 760px) {
      table.claims, table.claims tbody, table.claims tr, table.claims td { display:block; width:auto !important; }
      table.claims thead { display:none; }
      table.claims tr { padding:18px 0; border-bottom:1px solid var(--line); }
      table.claims td { border:0; padding:4px 0; }
      table.claims td[data-label]::before { content:attr(data-label); display:block; font:500 11px/1.4 var(--mono); text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); margin:8px 0 2px; }
    }
    table.cmp { min-width:760px; }
    table.cmp th[scope=row] { width:20%; font-weight:700; position:sticky; left:0; background:var(--bg); }
    table.cmp td { min-width:180px; }
    table.cmp td .cell-head { margin-bottom:2px; display:flex; flex-wrap:wrap; align-items:center; gap:4px 8px; }
    ul.cond { margin:2px 0 0; padding-left:16px; } ul.cond li { margin:0; }
    :target { scroll-margin-top:24px; }
    tr:target td { background:var(--soft); }

    /* lists of entries */
    .rows { list-style:none; padding:0; margin:0; border-top:2px solid var(--rule); }
    .rows li { margin:0; border-bottom:1px solid var(--line); }
    .rows a.row { display:grid; grid-template-columns:minmax(0, 1fr) auto; gap:6px 24px; padding:20px 0; text-decoration:none; }
    .rows a.row:hover .row-title { text-decoration:underline; }
    .row-title { font-size:21px; font-weight:700; letter-spacing:-0.015em; line-height:1.25; }
    .row-sum { grid-column:1; color:var(--muted); font-size:15.5px; line-height:1.5; }
    .row-tags { grid-column:2; grid-row:1 / span 2; align-self:start; display:flex; flex-wrap:wrap; justify-content:flex-end; max-width:240px; }
    .row-num { font:500 13px/1 var(--mono); color:var(--muted); }
    @media (max-width: 640px) { .rows a.row { grid-template-columns:1fr; } .row-tags { grid-column:1; grid-row:auto; justify-content:flex-start; max-width:none; } }

    /* buttons */
    .btns { display:flex; flex-wrap:wrap; gap:12px; margin:28px 0 0; }
    .btn { display:inline-flex; align-items:center; gap:8px; padding:13px 20px; border:2px solid var(--fg); font-weight:700; font-size:15px; text-decoration:none; }
    .btn-solid { background:var(--fg); color:var(--bg); }
    .btn:hover { text-decoration:none; background:var(--fg); color:var(--bg); }

    .pill { display:inline-block; padding:1px 8px; border:1px dashed var(--muted); font:500 11px/1.6 var(--mono); text-transform:uppercase; letter-spacing:0.04em; color:var(--muted); vertical-align:middle; }

    /* guides */
    article.guide { font-size:18px; line-height:1.68; }
    article.guide h2 { font-size:28px; margin-top:48px; }
    article.guide a[href*="#claim-"] { text-decoration:none; font:500 0.68em/1 var(--mono); vertical-align:super; padding:0 1px; }
    article.guide table { font-size:15px; margin:8px 0 24px; border-top:2px solid var(--rule); }
    article.guide blockquote { margin:24px 0; padding:4px 0 4px 20px; border-left:3px solid var(--rule); }
    article.guide code { font:0.88em var(--mono); background:var(--soft); padding:1px 5px; }

    .banner { background:var(--fg); color:var(--bg); padding:6px 16px; text-align:center; font:500 13px/1.5 var(--mono); }

    /* footer */
    .site-foot { border-top:3px solid var(--rule); padding:32px 0 48px; font:400 13px/1.7 var(--mono); }
    .site-foot .wrap { display:grid; grid-template-columns:minmax(0, 1fr) auto; gap:24px 48px; align-items:start; }
    .site-foot .brand img { width:22px; height:22px; } .site-foot .brand span { font-size:17px; }
    .site-foot p { margin:10px 0 0; color:var(--muted); max-width:460px; }
    .site-foot nav { display:grid; grid-template-columns:repeat(2, auto); gap:4px 32px; }
    .site-foot nav a { text-decoration:none; } .site-foot nav a:hover { text-decoration:underline; }
    @media (max-width: 640px) { .site-foot .wrap { grid-template-columns:1fr; } }
  </style>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  {isPreview && <div class="banner">Preview build — includes unpublished drafts</div>}
  <header class="site-head">
    <div class="wrap">
      <a class="brand" href="/" aria-label="Vaivoo home"><img src="/vaivoo-mark.svg" alt="" width="28" height="28" /><span>vaivoo</span></a>
      <nav class="site-nav" aria-label="Main">
        {nav.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main" class={wide ? 'wide' : undefined} data-pagefind-body><div class="wrap"><slot /></div></main>
  <footer class="site-foot">
    <div class="wrap">
      <div>
        <a class="brand" href="/" aria-label="Vaivoo home"><img src="/vaivoo-mark.svg" alt="" width="22" height="22" /><span>vaivoo</span></a>
        <p>An independent project. Every claim is scoped, sourced and signed by its reviewer.</p>
      </div>
      <nav aria-label="Footer">
        <a href="/about/">About</a><a href="/methodology/">Methodology</a>
        <a href="/corrections/">Corrections</a><a href="/privacy/">Privacy</a>
        <a href="/reference/">Reference</a><a href="/data/entities.json">Data (JSON)</a>
      </nav>
    </div>
  </footer>
</body>
</html>
