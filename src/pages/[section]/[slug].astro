---
import Base from '../../layouts/Base.astro';
import { allEntities, byId, publicClaims, VALUE_LABEL } from '../../lib/content.mjs';
export function getStaticPaths() {
  return allEntities().map(e => ({ params: { section: e.section, slug: e.slug }, props: { e } }));
}
const { e } = Astro.props;
const claims = publicClaims(e);
const rels = (e.relations || []).map(r => ({ ...r, target: byId(r.object_id) })).filter(r => r.target);
---
<Base title={e.name} description={e.summary}>
  <p class="meta">{e.type} {e.status !== 'published' && <span class="pill">{e.status}</span>} · Last verified: {e.last_verified_at ?? 'not yet verified'}</p>
  <h1>{e.name}</h1>
  {e.aliases?.length > 0 && <p class="meta">Also known as: {e.aliases.join(', ')}</p>}
  <p><strong>{e.summary}</strong></p>
  {e.body && <section><h2>How it works</h2><div set:html={e.body.split(/\n\n+/).map(p => `<p>${p}</p>`).join('')} /></section>}

  <section>
    <h2>Properties</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>Property</th><th>Value</th><th>Conditions and scope</th><th>Evidence</th></tr></thead>
      <tbody>{claims.map(c => (
        <tr id={c.id}>
          <td>{c.predicate.replaceAll('_', ' ')}</td>
          <td class={`v-${c.shown}`}>{VALUE_LABEL[c.shown]}{c.unverified && <div class="meta">not yet verified</div>}</td>
          <td>{c.statement}{c.assumptions.length > 0 && <ul>{c.assumptions.map(a => <li>{a}</li>)}</ul>}<div class="meta">Scope: {c.scope}</div></td>
          <td>{c.evidence.map(ev => <div><a href={ev.url} rel="noopener">{ev.title}</a><div class="meta">{ev.publisher}{ev.version && `, ${ev.version}`} — {ev.locator} (retrieved {ev.retrieved_at})</div></div>)}</td>
        </tr>))}
      </tbody>
    </table></div>
  </section>

  {e.crypto && <section><h2>Cryptography under the hood</h2><div set:html={e.crypto.split(/\n\n+/).map(p => `<p>${p}</p>`).join('')} /></section>}
  {rels.length > 0 && <section><h2>Related</h2><ul>{rels.map(r => <li>{r.predicate.replaceAll('_', ' ')}: <a href={r.target.url}>{r.target.name}</a></li>)}</ul></section>}
  <p class="meta">Owner: {e.owner} · Next review: {e.next_review_at ?? '—'} · <a href="/corrections/">Report a correction</a></p>
</Base>
